// DEF CON Defacement SMS - Prisma schema
// Domain ported from the prior Flask app's SQL schema.
// User PK is cuid (NextAuth convention); domain tables use Int autoincrement
// to keep parity with the Flask app for imports and spreadsheet refs.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Auth & Users
// ============================================================

enum UserRole {
  admin
  lead
  volunteer
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  image            String?
  emailVerified    DateTime?
  role             UserRole  @default(volunteer)
  isActive         Boolean   @default(true)
  tokenVersion     Int       @default(0)
  // SHA-256 hex of the invitation token. The plaintext token only ever
  // travels in the email link; the DB stores the hash so a database breach
  // cannot trivially convert unused invites into accounts.
  invitationTokenHash String?   @unique @map("invitation_token_hash")
  invitationExpiry    DateTime?
  invitedAt        DateTime?
  firstLoginAt     DateTime?
  lastLoginAt      DateTime?
  profileCompleted Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invitedById String?
  invitedBy   User?   @relation("UserInvites", fields: [invitedById], references: [id])
  invitees    User[]  @relation("UserInvites")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// Domain
// ============================================================

enum SignStatus {
  pending
  generated // art produced in Figma (between intake and print)
  printed
  delivered
  sorted // staged by destination after delivery, before deploy
  deployed
  // External-item lifecycle (Phase 2): union_installed / ops_map signs are produced
  // off-site and installed by external actors, so after `delivered` (we accept the
  // print-shop delivery) they go handed_off (out to a union crew / ops team) →
  // installed (we confirm it went up), instead of our own sorted → deployed flow.
  // Appended last because Postgres ALTER TYPE ADD VALUE appends; SIGN_STATUSES
  // (signs/_lib.ts) — never the enum's internal order — drives display + ranking.
  handed_off
  installed
  // Soft-removed from the per-size record (the DC34 add/remove/move engine). A
  // sign reaches this ONLY via the gated archive action (remove-actions.ts) and
  // ONLY from pending/generated — never a normal lifecycle target. Deliberately
  // NOT in SIGN_STATUSES (signs/_lib.ts): it's excluded from every status picker,
  // the offline-sync working set, and rank math for free, and buildSignWhere
  // hides it from the default list. Restore reads the prior status back from
  // StatusHistory. Appended last (ALTER TYPE ADD VALUE appends).
  archived
}

// Physical item class. Distinct classes have distinct counting + hardware rules:
// easel_sign/meterboard need easels/stands and are deployed by us; socks need no
// hardware; ops_map (paper orientation maps) are handed to ops teams; union_installed
// (banners, floor/wall graphics, sticker walls) are hung by external union crews.
// `other` is the unclassified fallback. Set at import from the sheet's section
// structure (lib/print-summary sectionCategory/categoryFromSize), editable on the form.
enum SignCategory {
  easel_sign
  meterboard
  socks
  ops_map
  union_installed
  other
}

model Zone {
  id                 Int      @id @default(autoincrement())
  zoneCode           String   @unique @map("zone_code")
  zoneName           String   @map("zone_name")
  building           String?
  floor              String?
  deploymentPriority Int      @default(1) @map("deployment_priority")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  locations Location[]
  signs     Sign[]
  floorMaps FloorMap[]

  @@map("zones")
}

// A venue floor image, managed in-app (admin) rather than bundled at build time.
// Image bytes live in the DB (Postgres bytea) and are served by the cached,
// auth-gated route app/api/maps/[key]/route.ts. `key` is the stable slug used in
// URLs and stored on Sign.mapFloor. Replaces the old static lib/floor-maps.ts
// registry + public/maps/*.png so maps can be added/replaced/disabled at runtime
// (e.g. Halls + North Hall when this year's assets land). Pins are percentages
// over the image, so the stored width/height are advisory metadata only.
model FloorMap {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  label       String
  building    String?
  floor       String?
  // The deployment zone this map represents, if any. Used to derive a sign's
  // default floor from its zone (see lib/sign-pin.ts). Optional: a one-off map
  // (e.g. a village layout) need not map to a zone.
  zoneId      Int?     @map("zone_id")
  imageData   Bytes    @map("image_data")
  contentType String   @map("content_type")
  width       Int?
  height      Int?
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  zone  Zone?      @relation(fields: [zoneId], references: [id])
  rooms Location[]

  @@index([zoneId])
  @@index([enabled, sortOrder])
  @@map("floor_maps")
}

model Location {
  id           Int      @id @default(autoincrement())
  locationCode String   @unique @map("location_code")
  building     String
  floor        String?
  section      String?
  zoneId       Int?     @map("zone_id")
  isActive     Boolean  @default(true) @map("is_active")
  notes        String?
  // Venue-map pin (percentages 0–100 on the floor image). Set once per room and
  // reused year over year for the stable LVCC levels. Signs referencing this
  // location inherit the pin (see Sign.locationId).
  mapX         Float?   @map("map_x")
  mapY         Float?   @map("map_y")
  // The floor map this room sits on. Lets rooms attach to a map directly rather
  // than only via zone (so a map can be reassigned without re-zoning). Optional
  // while rooms are still zone-driven; populated as floor maps take over.
  floorMapId   Int?     @map("floor_map_id")
  createdAt    DateTime @default(now()) @map("created_at")

  zone     Zone?     @relation(fields: [zoneId], references: [id])
  floorMap FloorMap? @relation(fields: [floorMapId], references: [id], onDelete: SetNull)
  signs    Sign[]

  @@index([zoneId])
  @@index([floorMapId])
  @@map("locations")
}

// A generation batch: one "Generate" action over a selection of signs. The app
// is the system-of-record for the generation lifecycle — it doesn't render the
// art (that's the Figma/Python step), it records who generated which signs when,
// which pipeline, and the resulting editable Figma file URL. `signCount` is a
// snapshot at creation time; the live set is the `signs` back-relation.
// Actor is a free string (createdById/Email) like StatusHistory.changedBy /
// AuditLog — no FK to User, so a user hard-delete can't orphan a batch.
model GenerationBatch {
  id             Int      @id @default(autoincrement())
  label          String?
  pipeline       String   @default("figma-mcp")
  figmaUrl       String?  @map("figma_url")
  signCount      Int      @map("sign_count")
  createdById    String   @map("created_by_id")
  createdByEmail String?  @map("created_by_email")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  signs Sign[]

  @@index([createdAt])
  @@map("generation_batches")
}

model Sign {
  id       Int    @id @default(autoincrement())
  itemId   String @map("item_id")
  signText String @map("sign_text")
  // Back-face text for a double-sided board whose two faces differ (same artwork,
  // different words — e.g. workshop signs). NULL = same text both sides (the common
  // case, unchanged). Only meaningful when doubleSided; the form clears it otherwise.
  backText String? @map("back_text")
  // The master sheet's Name for this space — the STABLE identifier the M18
  // reconcile matches on (itemId + sheetName), kept distinct from signText (the
  // PRINTED text, which a sheet "text should be X" override can change). NULL for
  // non-sheet signs (all-venue standing signs, hand-added wayfinding), which the
  // `master-sheet` tag also keeps out of reconcile. See plans/m18-sheet-reconcile.md.
  sheetName String? @map("sheet_name")
  signType String @map("sign_type")

  // Request tracking
  requestor      String?
  requestorEmail String?  @map("requestor_email")
  requestDate    DateTime @default(now()) @map("request_date")

  // Specifications
  size          String
  quantity      Int          @default(1)
  // QM (quartermaster) checkout flag, per physical sign. NULL = still on the QM
  // pile; set = a team took this specific sign. Orthogonal to `status` (a sign can
  // leave QM before it's claimed/deployed). Flipped only by the group take/return
  // action (signs/stock-actions.ts) behind UPDATE … WHERE id IN (SELECT … LIMIT n
  // FOR UPDATE); every batch op is logged append-only in SignStockCheckout for
  // replay-safety. "Remaining at QM" for a group = its rows where qmTakenAt IS NULL.
  qmTakenAt     DateTime?    @map("qm_taken_at")
  qmTakenBy     String?      @map("qm_taken_by")
  doubleSided   Boolean      @default(false) @map("double_sided")
  needsEasel    Boolean      @default(false) @map("needs_easel")
  // Item class (drives per-category counts + hardware need). Defaults to `other`
  // (an explicit "needs classifying" signal, not a silent guess); import + form set it.
  category      SignCategory @default(other)
  // Whether this row is physically printed. False for bare-easel rows ("(easels
  // only)") that need easels but no sign — counted toward easels, excluded from prints.
  printable     Boolean      @default(true)

  // Placement
  placementArea      String?   @map("placement_area")
  exactDestination   String?   @map("exact_destination")
  zoneId             Int?      @map("zone_id")
  deploymentPriority Int       @default(2) @map("deployment_priority")
  deployByDate       DateTime? @map("deploy_by_date") @db.Date

  // Venue-map pin. A sign resolves its pin as: own override (mapX/mapY/mapFloor)
  // → else its registry room (locationId → Location.mapX/mapY) → else unplaced.
  // See lib/sign-pin.ts.
  locationId Int?    @map("location_id")
  mapX       Float?  @map("map_x")
  mapY       Float?  @map("map_y")
  mapFloor   String? @map("map_floor")

  // Cost
  costPerUnit Decimal? @map("cost_per_unit") @db.Decimal(10, 2)
  totalCost   Decimal? @map("total_cost") @db.Decimal(10, 2)

  // Status workflow
  status     SignStatus @default(pending)
  approvedBy String?    @map("approved_by")
  approvedAt DateTime?  @map("approved_at")

  // Art generation (Figma pipeline). The legacy PSD-era columns + the dead
  // SignTemplate model/FK were dropped in M17 #97 (migration
  // drop_dead_signtemplate_psd_columns) — they had zero application code.
  generationPipeline  String?  @map("generation_pipeline")
  figmaInstanceNodeId String?  @map("figma_instance_node_id")
  previewImagePath    String?  @map("preview_image_path")
  // The batch that last generated this sign (in-app generation orchestration).
  generationBatchId   Int?     @map("generation_batch_id")

  // Event scheduling (rotating signs)
  eventStart     DateTime? @map("event_start")
  eventEnd       DateTime? @map("event_end")
  deploymentSlot String?   @map("deployment_slot")

  // Delivery
  deliveredBy String?   @map("delivered_by")
  deliveredAt DateTime? @map("delivered_at")
  // Receiving detail for externally-produced items (Phase 2): how many actually
  // arrived from the print shop vs `quantity` ordered, any damage/condition note,
  // and an optional proof photo (Blob pathname, server-only — mirrors deployPhotoUrl).
  receivedQty      Int?    @map("received_qty")
  deliveryCondition String? @map("delivery_condition")
  deliveryPhotoUrl  String? @map("delivery_photo_url")

  // Deployment
  deployedBy          String?   @map("deployed_by")
  deployedAt          DateTime? @map("deployed_at")
  deploymentNotes     String?   @map("deployment_notes")
  equipmentCheckedOut Boolean   @default(false) @map("equipment_checked_out")
  equipmentReturned   Boolean   @default(false) @map("equipment_returned")

  // External handoff lifecycle (Phase 2) — for union_installed / ops_map items we
  // don't deploy ourselves. handedOffTo is a free-text recipient ("Union Local 720 —
  // Mike", "NOC dispatch"), matching the loose actor-reference convention (deployedBy,
  // changedBy — no FK). handoffPhotoUrl and installPhotoUrl are Blob pathnames
  // (server-only). install* is our confirmation the item went up, with an optional
  // proof photo. Timestamps stamped by stampsForStatus on the
  // handed_off / installed transitions; the structured fields set by the dedicated
  // lifecycle actions (signs/lifecycle-actions.ts).
  handedOffTo    String?   @map("handed_off_to")
  handedOffBy    String?   @map("handed_off_by")
  handedOffAt    DateTime? @map("handed_off_at")
  handoffNotes   String?   @map("handoff_notes")
  handoffPhotoUrl String?  @map("handoff_photo_url")
  installedBy    String?   @map("installed_by")
  installedAt    DateTime? @map("installed_at")
  installNotes   String?   @map("install_notes")
  installPhotoUrl String?  @map("install_photo_url")

  // Field-deployment claim (M6). A crew claims a `sorted` sign for deployment;
  // the claim is an exclusive lock (claimedByCrewId non-null = held), orthogonal
  // to status — the sign stays `sorted` while claimed and only moves to
  // `deployed` on a deploy event. No FK to Crew: crews are soft-deleted
  // (Crew.isActive), so a dangling claimedByCrewId can't outlive a hard delete,
  // and this matches the codebase convention of free-string/loose user refs
  // (deployedBy, StatusHistory.changedBy). claimedByUserId records which crew
  // member performed the claim (denormalized, like deployedBy).
  claimedByCrewId Int?      @map("claimed_by_crew_id")
  claimedByUserId String?   @map("claimed_by_user_id")
  claimedAt       DateTime? @map("claimed_at")
  // Latest deploy photo for cheap list/map rendering; full history lives in
  // DeployEvent. Patched async after the Blob upload completes.
  deployPhotoUrl  String?   @map("deploy_photo_url")

  // Metadata
  notes      String?
  isTestData Boolean  @default(false) @map("is_test_data")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  zone            Zone?               @relation(fields: [zoneId], references: [id])
  location        Location?           @relation(fields: [locationId], references: [id])
  generationBatch GenerationBatch?    @relation(fields: [generationBatchId], references: [id], onDelete: SetNull)
  statusHistory   StatusHistory[]
  tagAssignments  SignTagAssignment[]

  @@index([status])
  @@index([requestor])
  @@index([zoneId])
  @@index([locationId])
  @@index([deploymentPriority])
  @@index([signType])
  @@index([category])
  @@index([itemId])
  @@index([eventStart])
  @@index([deploymentSlot])
  @@index([generationPipeline])
  @@index([generationBatchId])
  // Composite indexes for the list page's filter+sort (filter col first, then the
  // [deploymentPriority, itemId] sort) so a status/zone-filtered list is one scan.
  @@index([status, deploymentPriority, itemId])
  @@index([zoneId, deploymentPriority, itemId])
  // Field-deployment: "my crew's claimed signs" and "claimable sorted signs".
  @@index([claimedByCrewId])
  @@index([status, claimedByCrewId])
  // Dashboard due-today/overdue counts (status filter + deployByDate range).
  @@index([status, deployByDate])
  // Delta-pull sync: changes() filters working statuses by updatedAt > cursor.
  @@index([status, updatedAt])
  // QM checkout: "remaining at QM" / candidate-row selection filters a group's
  // rows by qmTakenAt IS NULL (see signs/stock-actions.ts).
  @@index([qmTakenAt])
  // Trigram GIN indexes for the list's free-text ILIKE search (the migration
  // also does CREATE EXTENSION pg_trgm, which the schema can't express).
  @@index([signText(ops: raw("gin_trgm_ops"))], type: Gin, map: "signs_sign_text_trgm_idx")
  @@index([itemId(ops: raw("gin_trgm_ops"))], type: Gin, map: "signs_item_id_trgm_idx")
  @@index([placementArea(ops: raw("gin_trgm_ops"))], type: Gin, map: "signs_placement_area_trgm_idx")
  // M18 reconcile identity guard (#228): stops a repeat/concurrent reconcile apply
  // from double-creating the same master-sheet space. The REAL index is PARTIAL —
  // `WHERE is_test_data = false AND sheet_name IS NOT NULL AND status <> 'archived'`,
  // which is what exempts test fixtures, the all-venue QM stock piles (N rows, NULL
  // sheet_name), and soft-removal tombstones — a removed-then-re-added sign
  // legitimately leaves one archived row beside its live replacement. Prisma
  // cannot express a partial index, so the migration hand-writes it under exactly the
  // name Prisma derives from this @@unique; declaring it here keeps `migrate dev`
  // from seeing drift. Verified, not assumed: `prisma migrate diff
  // --from-config-datasource --to-schema` against a shadow DB with all migrations
  // applied reports an empty migration.
  // CAUTION: because the DB index is partial, this compound key is NOT unique over
  // the whole table — do NOT use `itemId_sheetName_category` as a findUnique/upsert
  // selector, or it will silently resolve one of several test-data rows. The archived
  // exemption makes that sharper: remove/re-add is a NORMAL flow, so multiple rows
  // sharing this key is the expected steady state, not an edge case.
  // See migrations/20260724120000_add_signs_sheet_identity_unique, whose predicate is
  // superseded by 20260725030000_exempt_archived_from_sheet_identity_unique.
  @@unique([itemId, sheetName, category])
  @@map("signs")
}

model StatusHistory {
  id        Int      @id @default(autoincrement())
  signId    Int      @map("sign_id")
  // Discriminates what kind of change this row records. "status" (the default and
  // the only historical value) uses old/new_status as SignStatus values; "format"
  // uses them to carry the from/to format *labels* (e.g. "Foamcore 22×28"), so a
  // reformat shows on the same per-sign timeline as a status change. The render
  // layer branches on this so a format label never renders as a status badge.
  changeType String  @default("status") @map("change_type")
  oldStatus String?  @map("old_status")
  newStatus String?  @map("new_status")
  changedBy String?  @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at")
  notes     String?
  // Idempotency key for offline-queued status changes (M11 #2). Online changes
  // leave it null (Postgres allows many NULLs under a unique index); a queued
  // change carries the client UUID so an at-least-once replay dedupes here.
  clientId  String?  @unique @map("client_id")

  sign Sign @relation(fields: [signId], references: [id], onDelete: Cascade)

  @@index([signId])
  @@map("status_history")
}

model SignTag {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String   @default("#00BCD4")
  createdAt   DateTime @default(now()) @map("created_at")

  signAssignments SignTagAssignment[]

  @@map("sign_tags")
}

model SignTagAssignment {
  signId Int @map("sign_id")
  tagId  Int @map("tag_id")

  sign Sign    @relation(fields: [signId], references: [id], onDelete: Cascade)
  tag  SignTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([signId, tagId])
  // The composite PK only indexes the signId-leading direction; filtering the
  // list by tag does the reverse lookup on tag_id, so index it.
  @@index([tagId])
  @@map("sign_tag_assignments")
}

// ============================================================
// Field deployment (M6)
// ============================================================

// A deployment crew — self-serve, created on the floor, flexible membership
// (1+). Crews are soft-deleted (isActive) rather than hard-deleted, so a
// Sign.claimedByCrewId never dangles past a delete. createdByUserId is a loose
// reference (no FK), matching the codebase's actor-reference convention.
model Crew {
  id              Int          @id @default(autoincrement())
  name            String
  createdByUserId String       @map("created_by_user_id")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")

  members CrewMember[]

  @@index([isActive])
  @@map("crews")
}

// Crew membership join. Composite PK mirrors SignTagAssignment; the reverse
// (userId-leading) lookup is indexed. crewId cascades so removing a crew clears
// its memberships; userId is a loose reference (no FK), like other user refs.
model CrewMember {
  crewId   Int      @map("crew_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@id([crewId, userId])
  @@index([userId])
  @@map("crew_members")
}

// Append-only deploy log: who/what/when for claims-to-deploy and photo confirms.
// Deliberately FK-free (like AuditLog) so it survives the sign/crew it records
// being deleted. clientId is the offline-client idempotency key — a unique
// constraint makes replay a no-op. status is "applied" (this event set the
// sign's terminal deployed state) or "conflict" (a later/duplicate deploy of an
// already-deployed sign — recorded for after-action review, doesn't overwrite).
model DeployEvent {
  id               Int      @id @default(autoincrement())
  clientId         String   @unique @map("client_id")
  signId           Int      @map("sign_id")
  crewId           Int?     @map("crew_id")
  deployedByUserId String?  @map("deployed_by_user_id")
  deployedByEmail  String?  @map("deployed_by_email")
  deployedAt       DateTime @map("deployed_at")
  notes            String?
  photoUrl         String?  @map("photo_url")
  // Only "applied" or "conflict" are ever written (duplicates are never
  // persisted — see lib/deploy/resolve.ts classifyDeploys). Kept as a free String
  // rather than a Postgres enum to avoid a migration for a two-value, append-only
  // log column.
  status           String
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([signId])
  @@index([crewId])
  @@index([createdAt])
  @@map("deploy_events")
}

// Append-only ledger of QM stock check-out / return *batches* — the idempotency
// guard behind the per-row Sign.qmTakenAt flags. Mirrors DeployEvent: FK-free so a
// row survives the signs it records being deleted, and loose actor refs (no FK to
// User). A batch take/return flips N rows of a group at once; `groupKey` is the
// serialized identity key the batch acted on (signText|signType|size|category|
// doubleSided|needsEasel|printable|zoneId|deploymentSlot) and `delta` is signed
// (+n = taken from QM, −n = returned). A unique clientId makes an at-least-once
// replay (double-tap / offline retry) exactly-once. The flags are the source of
// truth; this table is the replay guard + audit trail.
model SignStockCheckout {
  id        Int      @id @default(autoincrement())
  clientId  String   @unique @map("client_id")
  groupKey  String   @map("group_key")
  delta     Int
  byUserId  String?  @map("by_user_id")
  byEmail   String?  @map("by_email")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([groupKey])
  @@index([createdAt])
  @@map("sign_stock_checkouts")
}

// ============================================================
// Equipment tracking
// ============================================================

model EquipmentType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  inventory EquipmentInventory[]

  @@map("equipment_types")
}

model EquipmentInventory {
  id              Int      @id @default(autoincrement())
  equipmentTypeId Int      @map("equipment_type_id")
  year            Int
  countStartOfCon Int      @default(0) @map("count_start_of_con")
  countEndOfCon   Int      @default(0) @map("count_end_of_con")
  countOrdered    Int      @default(0) @map("count_ordered")
  countReceived   Int      @default(0) @map("count_received")
  notes           String?
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Cascade)

  @@unique([equipmentTypeId, year])
  @@index([year])
  @@map("equipment_inventory")
}

// ============================================================
// Audit log
// ============================================================

// Append-only record of destructive / sensitive admin actions (bulk deletes,
// imports). Deliberately has NO foreign key to signs/users so it survives the
// rows it records being deleted.
model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  actorId    String?  @map("actor_id")
  actorEmail String?  @map("actor_email")
  detail     String?
  // Login-event context (auth.login / auth.denied only; null for admin events).
  // No raw IP is ever stored — location is a coarse "City, CC" derived from
  // Vercel's edge geo headers; userAgent is the raw UA string, formatted at render.
  userAgent  String?  @map("user_agent")
  location   String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([action])
  @@map("audit_log")
}
