# --- Database ---
# Postgres connection string. Use the pooled URL for the app runtime (DATABASE_URL).
# For `prisma migrate`, run with DATABASE_URL set to the unpooled (direct) URL —
# see DEPLOY.md step 1. DIRECT_URL is kept here for reference (the migration URL);
# the app itself reads only DATABASE_URL via the pg driver adapter.
DATABASE_URL="postgresql://user:password@db.example.com/defacement?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@db.example.com/defacement?sslmode=require"

# --- NextAuth (v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Public URL of the deployed app. Vercel sets NEXTAUTH_URL for you,
# but local dev needs it explicit. On a self-hosted deploy, set it to the public
# https origin, e.g. https://app.example.com
#
# AUTH_URL is NextAuth v5's preferred name for this value (NEXTAUTH_URL is the v4
# name it keeps for back-compat). This app sets NEXTAUTH_URL in every manifest and
# its email-link builder reads NEXTAUTH_URL ?? AUTH_URL ?? http://localhost:3000
# (app/(app)/users/actions.ts), so AUTH_URL is effectively unused when NEXTAUTH_URL
# is set — set NEXTAUTH_URL, you don't need both. Neither is a required prod var
# (lib/env.ts assertProdEnv checks neither; the fallback means no startup guard is
# needed); AUTH_URL is documented here only so an env audit accounts for it.
NEXTAUTH_URL="http://localhost:3000"

# Trust the reverse proxy's forwarded host/proto headers. REQUIRED when running
# behind a proxy that terminates TLS (e.g. nginx or Caddy), or NextAuth derives
# the wrong callback origin. Leave unset locally / on Vercel.
# NEXTAUTH_URL is the canonical public origin; AUTH_URL is accepted as a fallback alias.
# Also REQUIRED in prod if LANDING_APEX_HOST is set (sign-in completes on the
# apex host, so NextAuth must trust the request host).
AUTH_TRUST_HOST=""

# --- Public landing "door" (M13) ---
# The bare/apex public domain that should show the landing placard at "/".
# When a request's Host matches this, the edge proxy rewrites "/" -> "/login"
# (the landing -> terminal boot -> sign-in "door") for UNauthenticated visitors;
# authenticated visitors fall through to the app. The app subdomain is never
# matched. Leave UNSET in dev/staging — unset = no host routing at all (behaves
# exactly as before). Set in prod to the apex only, e.g. example.com
# (comparison is case-insensitive and ignores any port). When set, also add the
# apex Google callback (below) and set AUTH_TRUST_HOST=true so apex sign-in works.
LANDING_APEX_HOST=""

# --- Google OAuth ---
# Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
#   https://<apex-domain>/api/auth/callback/google   # only if LANDING_APEX_HOST is set
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (Resend / magic links) ---
# Passwordless sign-in links for teammates who can't use Google OAuth. Create a
# Resend account (https://resend.com, sign in with GitHub), then API Keys → copy
# the key here.
#
# Before links deliver to anyone other than your own Resend account email, you
# must VERIFY A SENDING DOMAIN in Resend (Domains → add a send-subdomain like
# send.yourdomain.com → add the shown DKIM/SPF DNS records). Until then,
# the sandbox delivers only to the account owner's address — enough to test the
# flow locally. EMAIL_FROM must use a verified (sub)domain in prod.
AUTH_RESEND_KEY=""
EMAIL_FROM="Defacement SMS <noreply@example.com>"

# --- Upstash Redis (rate limiting) ---
# Optional in dev (rate limiter no-ops gracefully when missing).
# Required in production to throttle brute-force on /api/auth/* AND on the
# /login sign-in Server Actions (Google + magic link), which are the paths the
# real UI actually uses.
# Create a free Redis DB at https://console.upstash.com → REST API tab.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Escape hatch for a self-hosted deploy that deliberately runs WITHOUT Upstash:
# set to 1 to let the prod env preflight (lib/env.ts) skip ONLY the two UPSTASH_*
# vars above so the server boots (the limiter then fails open). Leave empty
# everywhere else — NEVER set this in production.
RATELIMIT_OPTIONAL=""

# How many proxy hops to count back from the RIGHT of x-forwarded-for when
# deriving the client IP that keys the rate limiters (lib/client-ip.ts).
# Unset = 1 = the rightmost entry, which is the address the nearest trusted proxy
# actually observed — a client that prepends its own "x-forwarded-for: 1.2.3.4"
# then only pollutes entries we ignore, so it can't rotate the header to win a
# fresh rate-limit budget per request.
#
# Leave UNSET on Vercel (its edge REPLACES the header, so there is one entry) and
# behind a single reverse proxy that APPENDS to the chain (the rightmost entry is
# then correct). Only set it if you add FURTHER trusted proxies in front that each
# append their own hop: with N such proxies, set TRUST_PROXY_DEPTH=N to skip past
# them back to the client.
#
# SET IT TO EXACTLY THE NUMBER OF APPENDING PROXIES — no more. This is the one
# genuinely dangerous knob here: every hop you claim beyond the ones that really
# exist is one entry of attacker-controlled header the app starts trusting. An
# attacker who knows (or guesses) an overshoot simply prepends that many entries
# and the limiter keys on a value they rotate at will — a silent, total bypass of
# the auth rate limit, with no error and nothing in the logs. Undershooting is
# safe by comparison (it over-throttles). If you are not certain of the number,
# leave this unset.
# A malformed value (0, negative, non-integer) falls back to the safe default.
TRUST_PROXY_DEPTH=""

# --- Vercel Blob (M6 deploy/sign photos) ---
# Stores photos with PRIVATE access (served back only through the app's auth-gated
# /api/native/photos/* routes — never world-readable). The prod startup check
# (lib/env.ts) accepts EITHER auth mode:
#   - OIDC (recommended on Vercel): Storage -> your Blob store -> "Connect to
#     Project". Vercel injects BLOB_STORE_ID + VERCEL_OIDC_TOKEN (short-lived,
#     auto-rotated) + BLOB_WEBHOOK_PUBLIC_KEY. No static secret to manage, and the
#     app's server-side put/get/del use it automatically. Leave the token below empty.
#   - Static token: create the store with "include read-write token", or paste the
#     Blob store's Read/Write token here. Required OFF Vercel (e.g. self-hosted,
#     CI) where OIDC isn't available.
# Optional in dev — photo upload/serve just fails without either; photos are optional.
BLOB_READ_WRITE_TOKEN=""
# VERCEL_OIDC_TOKEN: paired with BLOB_STORE_ID for OIDC. Injected automatically by
# Vercel on every deployment (short-lived, auto-rotated) — never set it manually.

# --- Figma API (sign-preview import — importer A) ---
# A Figma personal access token, used ONLY by "Pull previews from Figma" on a
# generation batch (/signs/generate/[id]) to fetch the rendered sign images from
# the batch's Figma file and store them as sign previews. Create one at Figma →
# Settings → Security → Personal access tokens (file-read scope is enough).
# Optional everywhere — the feature reports "Figma API token not configured" when
# unset; everything else works without it (it is intentionally NOT a required
# prod var, so an unused feature can't crash-loop startup).
FIGMA_API_TOKEN=""

# --- Security headers ---
# CSP enforcement mode. Must be EXACTLY "enforce" or "report" — any other
# non-empty value (a typo like "enforced", or "true"/"1") degrades to
# report-only, so a production boot rejects it outright rather than silently
# shipping with CSP enforcement off. Leave it empty/unset to take the default:
# enforce in production, report in dev. Start a new deploy with "report",
# confirm no violations in the browser console / logs, then set to "enforce".
CSP_MODE=""

# --- Scheduled jobs (Vercel Cron) ---
# Shared secret for the daily login-audit retention purge
# (/api/cron/purge-login-audit, scheduled in vercel.json). Vercel Cron sends it
# as `Authorization: Bearer <CRON_SECRET>`; the route fails closed (401) when this
# is unset or mismatched. Generate like AUTH_SECRET. Optional in dev — the purge
# only matters once prod is accruing login rows; unset just means the route 401s.
CRON_SECRET=""

# --- Error monitoring (Sentry) ---
# Optional in dev / self-hosted: UNSET = complete no-op (no SDK init, nothing
# sent), so dev/CI/local behave exactly as before.
# REQUIRED ON VERCEL: assertProdEnv (lib/env.ts) refuses to boot a Vercel
# prod/preview deploy where either var is unset or unparseable, so observability
# can't silently ship off. The check is SKIPPED in the edge runtime, where a
# throw would fail every request proxy.ts matches; it runs everywhere else.
# Create a project at https://sentry.io (Next.js platform) and set BOTH vars below
# to its DSN (same value):
#   - SENTRY_DSN: server + edge errors — uncaught 500s (instrumentation.ts
#     onRequestError) + everything via lib/log.ts `logError` (DB/Upstash/Blob/email/
#     cron failures, rate-limiter fail-open, native-API 500s, proxy.ts failures).
#   - NEXT_PUBLIC_SENTRY_DSN: BROWSER errors users hit (unhandled exceptions/
#     rejections + the React error boundaries), tagged with the user's opaque id.
#     Also the DSN the EDGE runtime actually uses: only NEXT_PUBLIC_* is inlined
#     into the middleware bundle at build time, so this is the one that reliably
#     reaches proxy.ts. lib/csp.ts derives the ingest origin from whichever
#     resolves and auto-allows it in connect-src — no manual CSP edit.
# PASTE CAREFULLY — a leading byte-order mark (U+FEFF) makes the DSN truthy but
# unparseable, which is a silent way to end up with a dead browser SDK in prod.
# `Out-File`/`>` in PowerShell write UTF-8 WITH a BOM by default, so never pipe a
# DSN in from a file. lib/sentry-dsn.ts trims it defensively and warns (scope
# `sentry.dsn-invalid`) rather than failing silently, but the stored value should
# still be clean.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Denial-of-wallet / Vercel Spend Management ---
# Powers the auto-pause kill-switch: a signed Vercel Spend Management webhook
# (/api/webhooks/vercel-spend) that pauses the project(s) when spend hits 100%, so
# a runaway spike 503s the site instead of running up the card. ALL OPTIONAL — the
# route fails closed (401) without the secret, so these are NOT required prod vars
# and an unset deploy simply can't self-pause (Vercel's own "pause production"
# spend toggle is the primary kill-switch; this webhook is the observable backstop).
#
# Signing secret shown when you create the Spend Management webhook (Vercel ->
# Account/Team -> Billing -> Spend Management). The route verifies the
# x-vercel-signature HMAC-SHA1 against this and rejects anything that doesn't match.
VERCEL_WEBHOOK_SECRET=""
# Scoped Vercel API token (Account Settings -> Tokens) used ONLY to call the
# project pause endpoint. Give it the least scope that can pause the project/team.
VERCEL_API_TOKEN=""
# Comma-separated project id(s) to pause on a 100% spend event, e.g. prj_abc,prj_def.
VERCEL_PROJECT_IDS=""
# Team id that owns the project(s) (Team Settings). Omit for a personal account.
VERCEL_TEAM_ID=""
# Optional: address to also email when the kill-switch trips (best-effort, on top
# of Vercel's native spend alert). Reuses the Resend setup above; unset = log only.
SPEND_ALERT_EMAIL=""

# --- Con import defaults ---
# The CSV import parsers are reused year over year. These override the
# current-con defaults (e.g. 2025) so a new con needs no source edit.
# CON_YEAR resolves the deploy-by + event dates in the imported sheet (which
# carry only month/day). CON_SLUG prefixes the synthetic ids for blank-Map#
# rows — keep it stable across re-imports of the same sheet or dedup breaks.
CON_YEAR=""
CON_SLUG=""

# --- Bootstrap ---
# Comma-separated emails auto-provisioned as admin on first Google sign-in.
# Bootstrap only — registration is otherwise closed. Clear this once the
# invitation flow exists.
BOOTSTRAP_ADMIN_EMAILS=""
