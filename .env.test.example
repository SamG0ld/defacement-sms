# Integration-test database — copy to .env.test and point at a DISPOSABLE Postgres.
# The integration suite runs migrations, seeds, and TRUNCATEs tables here, so this
# MUST NOT be your dev or production data. Use a dedicated test branch/database or
# a throwaway local DB.
#
# Safety rail: tests/integration/global-setup.ts refuses to run unless the DB name
# contains "test" OR ALLOW_TEST_DB_RESET=1 is set — so a misconfigured URL can't
# wipe the wrong database.

DATABASE_URL="postgresql://user:pass@host/defacement_test?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/defacement_test?sslmode=require"

# Set to 1 only if your test DB name does not contain "test" and you are certain
# it is disposable.
# ALLOW_TEST_DB_RESET=1
