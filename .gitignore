# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Build outputs
/build
dist/

# Testing
/coverage
/test-results
/playwright-report
/playwright/.cache

# Environment and secrets
.env*
!.env.example
!.env.test.example
*.key
*.pem
credentials.json

# Vercel
.vercel

# Neon (neonctl local project state)
.neon

# IDE and tools
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*

# Local dev data
postgres-data/
backups/

# Generated Prisma client
/app/generated/prisma
